{
  "name": "goldcraft",
  "version": "1.0.0",
  "description": "Premium Goldsmith Billing Software",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && electron-builder",
    "preview": "vite preview",
    "build:mobile": "cross-env MOBILE=true tsc && cross-env MOBILE=true vite build",
    "android:sync": "npm run build:mobile && npx cap sync",
    "android:open": "npx cap open android",
    "build:apk": "npm run android:sync && cd android && .\\gradlew assembleDebug",
    "ios:sync": "npm run build:mobile && npx cap sync ios",
    "ios:open": "npx cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.4",
    "@capacitor/core": "^8.3.4",
    "@capacitor/ios": "^8.5.0",
    "@codetrix-studio/capacitor-google-auth": "^3.4.0-rc.4",
    "@supabase/supabase-js": "^2.106.2",
    "better-sqlite3": "^9.4.3",
    "firebase": "^12.18.0",
    "framer-motion": "^11.1.7",
    "jspdf": "^2.5.1",
    "jspdf-autotable": "^3.8.2",
    "lucide-react": "^1.28.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.12.7",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.3.4",
    "@types/better-sqlite3": "^7.6.9",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "cross-env": "^10.1.0",
    "electron": "^30.0.1",
    "electron-builder": "^24.13.3",
    "typescript": "^5.4.5",
    "vite": "^5.2.11",
    "vite-plugin-electron": "^0.28.6",
    "vite-plugin-electron-renderer": "^0.14.5",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.goldcraft.billing",
    "productName": "GoldCraft",
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis"
    }
  }
}
